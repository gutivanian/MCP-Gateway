# Postgres (Aiven or similar) — single connection string
DATABASE_URL=postgres://user:pass@host:port/dbname?sslmode=require
# CA cert PEM as a literal string (use \n for newlines if setting via a platform UI). Set DB_SSL=false to disable.
DB_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Session signing (users) — generate with: openssl rand -hex 32
CONDUIT_JWT_SECRET=

# Credential encryption at rest (gateway API keys) — generate with: openssl rand -hex 32
CONDUIT_ENCRYPTION_KEY=

# Only used by `npm run db:seed` (not needed at runtime)
CONDUIT_SEED_ADMIN_PASSWORD=
CONDUIT_SEED_ENKI_KEY=
CONDUIT_SEED_HIVE_KEY=
